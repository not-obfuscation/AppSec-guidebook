// Конфиг markdownlint-cli2 для тем гайдбука. Каждое отклонение от умолчаний —
// пункт `PLAYBOOK.md`, а не вкусовое решение; соответствие — в `STYLE.md`.
{
  "globs": ["content/**/*.md"],
  "config": {
    "default": true,

    // 6.4: уровни не пропускаются, H3 только после H2.
    "MD001": true,
    // 6.4: заголовки в стиле ATX.
    "MD003": { "style": "atx" },
    // 6.4: списки одного вида внутри документа.
    "MD004": { "style": "dash" },
    "MD005": true,
    "MD007": { "indent": 2 },
    // 6.4: заголовок без точки в конце. Двоеточие в заголовке темы законно
    // («Хранение паролей: bcrypt, argon2, почему не SHA»), поэтому из набора
    // знаков убрано.
    "MD026": { "punctuation": ".,;!?" },
    // Один h1 на страницу — заголовок темы после frontmatter. Поле `title`
    // во frontmatter за заголовок документа не считается: иначе h1 темы
    // объявляется вторым.
    "MD025": { "front_matter_title": "" },
    "MD041": { "front_matter_title": "" },
    // 7.1: язык указан в fence всегда, безымянных блоков нет.
    "MD040": true,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    // Пустые строки вокруг заголовков, списков и блоков кода.
    "MD022": true,
    "MD031": true,
    "MD032": true,
    // Пробелы и табуляции.
    "MD009": true,
    "MD010": true,
    "MD012": true,
    "MD047": true,
    // Темы пользуются <details> для ответов под раскрытием (блок 12 канона) и
    // <br/> внутри узлов mermaid. Остальной инлайновый HTML запрещён.
    "MD033": { "allowed_elements": ["details", "summary", "br"] },
    // 6.3 «одно написание термина на весь сайт» проверяет не MD044, а
    // `tools/glossary_lint.py` (G-CANON). Причина: MD044 сравнивает подстроки
    // без разбора контекста и ругается на имена доменов в блоке источников
    // (`graphql.org` → «GraphQL»), а список правильных написаний ему надо
    // держать вторым, вручную, рядом с глоссарием. Правило G-CANON читает тот
    // же `glossary.yaml`, что и сам глоссарий, и знает про URL и код.
    "MD044": false,

    // 7.1 п. 32: пояснения к листингу — выносками. Выноски нумеруются внутри
    // листинга, и продолжающий их список законно начинается с «4.», если в
    // коде стоят метки (4) и (5) (см. `rest-and-graphql`). MD029 такого
    // замысла не видит и считает началом списка любой первый пункт. Проверку
    // «номера идут по возрастанию с шагом 1» ведёт `tools/lint_style.py`,
    // S-LIST-ORDER — она допускает произвольное начало и ловит настоящую
    // поломку нумерации.
    "MD029": false,

    // 6.7: readability-порогов в проверках нет; норма длины строки в прозе
    // сводом не задана, поэтому MD013 выключен. Лимиты 7.1 (76 символов и
    // 25/40 строк в листингах) проверяет `tools/lint_style.py`, S-CODE-*.
    "MD013": false,

    // Абзац из одного выделенного фрагмента в темах — служебный аппарат
    // («**Описание схемы.**» и подобное), он предписан 7.4 п. 32.
    "MD036": false,

    // Одинаковые имена блоков в разных темах законны: канон скелета части 4
    // требует одних и тех же заголовков во всех темах.
    "MD024": { "siblings_only": true },

    // Стиль пробелов в таблицах свод не задаёт.
    "MD060": false,

    "MD030": true
  }
}
